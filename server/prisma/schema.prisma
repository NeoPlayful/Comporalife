generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  super_admin
  admin
  user
}

enum UserStatus {
  active
  disabled
  pending_verification
}

enum Theme {
  dark
  light
  system
}

enum AccountType {
  cash
  bank
  credit_card
  brokerage
  loan
  other
}

enum AccountStatus {
  active
  archived
}

enum CategoryKind {
  income
  expense
}

enum TransactionType {
  income
  expense
  transfer
  adjustment
  investment
}

enum TransactionStatus {
  posted
  voided
}

enum ContributionFrequency {
  none
  monthly
  annual
}

enum ContributionTiming {
  begin
  end
}

enum RateSource {
  manual
}

enum ImportStatus {
  uploaded
  parsed
  mapped
  validated
  committing
  completed
  failed
  cancelled
  rolled_back
}

enum ImportFormat {
  csv
  xlsx
}

enum ImportRowStatus {
  pending
  valid
  invalid
  duplicate
  suspected
  skipped
  imported
  failed
}

enum DuplicateKind {
  exact
  suspected
}

enum TransactionSource {
  manual
  import
}

enum BudgetPeriodType {
  monthly
  yearly
}

enum BudgetStatus {
  active
  archived
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  passwordHash    String     @map("password_hash")
  nickname        String
  role            UserRole   @default(user)
  status          UserStatus @default(active)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(6)
  lastLoginIp     String?    @map("last_login_ip")
  sessionVersion  Int        @default(1) @map("session_version")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  settings            UserSettings?
  sessions            UserSession[]
  accounts            Account[]
  categories          Category[]
  tags                Tag[]
  transactions        Transaction[]
  entries             TransactionEntry[]
  scenarios           SimulationScenario[]
  exchangeRates       ExchangeRate[]
  reconciliations     AccountReconciliation[]
  auditLogs           AuditLog[]
  importBatches       ImportBatch[]
  importTemplates     ImportTemplate[]
  classificationRules ClassificationRule[]
  budgets             Budget[]
  budgetItems         BudgetItem[]
  instruments         Instrument[]
  instrumentPrices    InstrumentPrice[]
  portfolios          Portfolio[]
  portfolioTrades     PortfolioTrade[]
  portfolioCashflows  PortfolioCashflow[]
  portfolioValuations PortfolioValuation[]
  portfolioTargets    PortfolioTarget[]
  monteCarloScenarios MonteCarloScenario[]
  monteCarloRuns      MonteCarloRun[]
  financialGoals      FinancialGoal[]
  reports             Report[]
  dataExports         DataExport[]
  backups             Backup[]
  jobTasks            JobTask[]

  @@map("users")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ip               String?
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("user_sessions")
}

model UserSettings {
  userId             String   @id @map("user_id") @db.Uuid
  baseCurrency       String   @default("CNY") @map("base_currency")
  timezone           String   @default("Asia/Shanghai")
  dateFormat         String   @default("YYYY-MM-DD") @map("date_format")
  theme              Theme    @default(dark)
  language           String   @default("zh-CN")
  simulationDefaults Json?    @map("simulation_defaults")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Account {
  id                 String        @id @default(uuid()) @db.Uuid
  userId             String        @map("user_id") @db.Uuid
  name               String
  type               AccountType
  institution        String?
  currency           String
  openingBalance     Decimal       @map("opening_balance") @db.Decimal(20, 6)
  openingBalanceDate DateTime      @map("opening_balance_date") @db.Date
  status             AccountStatus @default(active)
  note               String?
  version            Int           @default(1)
  archivedAt         DateTime?     @map("archived_at") @db.Timestamptz(6)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries         TransactionEntry[]
  reconciliations AccountReconciliation[]
  importBatches   ImportBatch[]
  portfolios      Portfolio[]
  financialGoals  FinancialGoal[]

  @@index([userId, status])
  @@map("accounts")
}

model AccountReconciliation {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  accountId        String   @map("account_id") @db.Uuid
  statementBalance Decimal  @map("statement_balance") @db.Decimal(20, 6)
  computedBalance  Decimal  @map("computed_balance") @db.Decimal(20, 6)
  difference       Decimal  @db.Decimal(20, 6)
  reconciledAt     DateTime @map("reconciled_at") @db.Date
  note             String?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId, accountId, reconciledAt])
  @@map("account_reconciliations")
}

model Category {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  kind      CategoryKind
  name      String
  parentId  String?      @map("parent_id") @db.Uuid
  sortOrder Int          @default(0) @map("sort_order")
  archived  Boolean      @default(false)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       Category?     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]    @relation("CategoryTree")
  transactions Transaction[]
  budgetItems  BudgetItem[]

  @@index([userId, kind, archived])
  @@index([userId, parentId])
  @@map("categories")
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions TransactionTag[]

  @@unique([userId, name])
  @@map("tags")
}

model Transaction {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @map("user_id") @db.Uuid
  type              TransactionType
  occurredAt        DateTime          @map("occurred_at") @db.Timestamptz(6)
  description       String
  merchant          String?
  note              String?
  categoryId        String?           @map("category_id") @db.Uuid
  status            TransactionStatus @default(posted)
  version           Int               @default(1)
  voidedAt          DateTime?         @map("voided_at") @db.Timestamptz(6)
  // 导入溯源：手工交易 source=manual 且其余字段为空
  source            TransactionSource @default(manual)
  importBatchId     String?           @map("import_batch_id") @db.Uuid
  importFingerprint String?           @map("import_fingerprint") @db.Char(64)
  externalId        String?           @map("external_id")
  balanceAfter      Decimal?          @map("balance_after") @db.Decimal(20, 6)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category?          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  importBatch ImportBatch?       @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  entries     TransactionEntry[]
  tags        TransactionTag[]
  importRows  ImportRow[]

  @@unique([userId, importFingerprint])
  @@index([userId, occurredAt(sort: Desc)])
  @@index([userId, type, occurredAt(sort: Desc)])
  @@index([userId, categoryId])
  @@index([userId, status])
  @@index([importBatchId])
  @@map("transactions")
}

model TransactionEntry {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  accountId     String?  @map("account_id") @db.Uuid
  amount        Decimal  @db.Decimal(20, 6)
  currency      String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account     Account?    @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([accountId, createdAt])
  @@index([userId, accountId])
  @@map("transaction_entries")
}

model TransactionTag {
  transactionId String @map("transaction_id") @db.Uuid
  tagId         String @map("tag_id") @db.Uuid

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@index([tagId])
  @@map("transaction_tags")
}

model SimulationScenario {
  id                    String                @id @default(uuid()) @db.Uuid
  userId                String                @map("user_id") @db.Uuid
  name                  String
  principal             Decimal               @db.Decimal(20, 6)
  contributionAmount    Decimal               @map("contribution_amount") @db.Decimal(20, 6)
  contributionFrequency ContributionFrequency @map("contribution_frequency")
  contributionTiming    ContributionTiming    @default(end) @map("contribution_timing")
  annualReturnRate      Decimal               @map("annual_return_rate") @db.Decimal(10, 6)
  years                 Int
  inflationRate         Decimal               @default(0) @map("inflation_rate") @db.Decimal(10, 6)
  feeRate               Decimal               @default(0) @map("fee_rate") @db.Decimal(10, 6)
  modelVersion          String                @default("compound-v1") @map("model_version")
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId, createdAt(sort: Desc)])
  @@map("simulation_scenarios")
}

model ExchangeRate {
  id            String     @id @default(uuid()) @db.Uuid
  userId        String     @map("user_id") @db.Uuid
  baseCurrency  String     @map("base_currency")
  quoteCurrency String     @map("quote_currency")
  rate          Decimal    @db.Decimal(20, 10)
  rateDate      DateTime   @map("rate_date") @db.Date
  source        RateSource @default(manual)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, baseCurrency, quoteCurrency, rateDate])
  @@index([userId, baseCurrency, quoteCurrency, rateDate(sort: Desc)])
  @@map("exchange_rates")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model ImportBatch {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @map("user_id") @db.Uuid
  accountId        String       @map("account_id") @db.Uuid
  status           ImportStatus @default(uploaded)
  originalFilename String       @map("original_filename")
  fileSize         Int          @map("file_size")
  fileSha256       String       @map("file_sha256") @db.Char(64)
  storageKey       String       @map("storage_key")
  encryptionIv     String       @map("encryption_iv")
  encryptionTag    String       @map("encryption_tag")
  format           ImportFormat
  encoding         String
  delimiter        String?
  sheetName        String?      @map("sheet_name")
  headerRow        Int?         @map("header_row")
  // 去重后的表头键列表，与 import_rows.raw 的键一一对应，重新映射时按位置取值
  headers          Json?
  templateId       String?      @map("template_id") @db.Uuid
  mapping          Json?
  totalRows        Int          @default(0) @map("total_rows")
  validRows        Int          @default(0) @map("valid_rows")
  invalidRows      Int          @default(0) @map("invalid_rows")
  duplicateRows    Int          @default(0) @map("duplicate_rows")
  suspectedRows    Int          @default(0) @map("suspected_rows")
  skippedRows      Int          @default(0) @map("skipped_rows")
  importedRows     Int          @default(0) @map("imported_rows")
  failureReason    String?      @map("failure_reason")
  committedAt      DateTime?    @map("committed_at") @db.Timestamptz(6)
  rolledBackAt     DateTime?    @map("rolled_back_at") @db.Timestamptz(6)
  cancelledAt      DateTime?    @map("cancelled_at") @db.Timestamptz(6)
  version          Int          @default(1)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  template     ImportTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  rows         ImportRow[]
  transactions Transaction[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, status])
  @@index([userId, fileSha256])
  @@map("import_batches")
}

model ImportRow {
  id            String          @id @default(uuid()) @db.Uuid
  batchId       String          @map("batch_id") @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  rowNumber     Int             @map("row_number")
  // 原始单元格数组，与批次 headers 按位置对应；重新映射时以此为准，避免重名表头丢失
  cells         Json
  // 表头 → 原始值，便于按列名阅读与导出
  raw           Json
  occurredAt    DateTime?       @map("occurred_at") @db.Timestamptz(6)
  amount        Decimal?        @db.Decimal(20, 6)
  currency      String?
  description   String?
  merchant      String?
  externalId    String?         @map("external_id")
  balanceAfter  Decimal?        @map("balance_after") @db.Decimal(20, 6)
  direction     String?
  fingerprint   String?         @db.Char(64)
  status        ImportRowStatus @default(pending)
  errors        Json?
  transactionId String?         @map("transaction_id") @db.Uuid
  duplicateKind DuplicateKind?  @map("duplicate_kind")
  duplicateOfId String?         @map("duplicate_of_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  batch       ImportBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([batchId, rowNumber])
  @@index([batchId, status])
  @@index([userId, fingerprint])
  @@map("import_rows")
}

model ImportTemplate {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  name            String
  bankName        String?      @map("bank_name")
  format          ImportFormat
  headerSignature String       @map("header_signature") @db.Char(64)
  mapping         Json
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  batches ImportBatch[]

  @@unique([userId, name])
  @@index([userId, format, headerSignature])
  @@map("import_templates")
}

model ClassificationRule {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  name          String
  priority      Int       @default(100)
  enabled       Boolean   @default(true)
  conditions    Json
  actions       Json
  matchCount    Int       @default(0) @map("match_count")
  lastAppliedAt DateTime? @map("last_applied_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId, priority])
  @@map("classification_rules")
}

model Budget {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  periodType  BudgetPeriodType @map("period_type")
  year        Int
  // 年度预算的 month 固定为 0：唯一索引允许多个 NULL，哨兵值才能让周期唯一性真正生效
  month       Int
  totalAmount Decimal?         @map("total_amount") @db.Decimal(20, 6)
  rollover    Boolean          @default(false)
  status      BudgetStatus     @default(active)
  note        String?
  version     Int              @default(1)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items BudgetItem[]

  @@unique([userId, periodType, year, month])
  @@index([userId, year, month])
  @@map("budgets")
}

model BudgetItem {
  id         String   @id @default(uuid()) @db.Uuid
  budgetId   String   @map("budget_id") @db.Uuid
  // 冗余归属，便于越权过滤与批量清理
  userId     String   @map("user_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  amount     Decimal  @db.Decimal(20, 6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  budget   Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([budgetId, categoryId])
  @@index([userId, categoryId])
  @@map("budget_items")
}

// ===== 投资 =====

enum AssetClass {
  stock
  etf
  fund
  bond
  cash
  other
}

enum TradeKind {
  buy
  sell
  dividend
  interest
  fee
  tax
}

enum CostBasisMethod {
  average
}

enum CashflowKind {
  deposit
  withdraw
}

enum PriceSource {
  manual
  imported
  provider
}

enum ValuationSource {
  computed
  manual
}

enum PortfolioStatus {
  active
  archived
}

enum AllocationDimension {
  asset_class
  instrument
  currency
}

model Instrument {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  symbol     String
  name       String
  assetClass AssetClass @map("asset_class")
  currency   String
  note       String?
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  prices InstrumentPrice[]
  trades PortfolioTrade[]

  @@unique([userId, symbol])
  @@index([userId, assetClass])
  @@map("instruments")
}

model InstrumentPrice {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  instrumentId String      @map("instrument_id") @db.Uuid
  priceDate    DateTime    @map("price_date") @db.Date
  price        Decimal     @db.Decimal(20, 8)
  source       PriceSource @default(manual)
  note         String?
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([instrumentId, priceDate])
  @@index([instrumentId, priceDate(sort: Desc)])
  @@index([userId])
  @@map("instrument_prices")
}

model Portfolio {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  // 一个资金账户最多对应一个组合：组合价值含账户现金，共用账户会把现金算两次
  accountId       String          @map("account_id") @db.Uuid
  name            String
  currency        String
  costBasisMethod CostBasisMethod @default(average) @map("cost_basis_method")
  status          PortfolioStatus @default(active)
  note            String?
  version         Int             @default(1)
  archivedAt      DateTime?       @map("archived_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  account    Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  trades     PortfolioTrade[]
  cashflows  PortfolioCashflow[]
  valuations PortfolioValuation[]
  targets    PortfolioTarget[]
  goals      FinancialGoal[]

  @@unique([userId, name])
  @@unique([userId, accountId])
  @@index([userId, status])
  @@map("portfolios")
}

model PortfolioTrade {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  portfolioId   String    @map("portfolio_id") @db.Uuid
  instrumentId  String?   @map("instrument_id") @db.Uuid
  kind          TradeKind
  tradeDate     DateTime  @map("trade_date") @db.Timestamptz(6)
  quantity      Decimal?  @db.Decimal(24, 8)
  price         Decimal?  @db.Decimal(20, 8)
  amount        Decimal   @db.Decimal(20, 6)
  fee           Decimal   @default(0) @db.Decimal(20, 6)
  tax           Decimal   @default(0) @db.Decimal(20, 6)
  transactionId String?   @map("transaction_id") @db.Uuid
  note          String?
  // 非空即不参与持仓重放与所有聚合
  voidedAt      DateTime? @map("voided_at") @db.Timestamptz(6)
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolio  Portfolio   @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  instrument Instrument? @relation(fields: [instrumentId], references: [id], onDelete: Restrict)

  @@index([portfolioId, tradeDate])
  @@index([portfolioId, instrumentId, tradeDate])
  @@index([userId, tradeDate])
  @@index([transactionId])
  @@map("portfolio_trades")
}

model PortfolioCashflow {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  portfolioId   String       @map("portfolio_id") @db.Uuid
  kind          CashflowKind
  flowDate      DateTime     @map("flow_date") @db.Timestamptz(6)
  amount        Decimal      @db.Decimal(20, 6)
  transactionId String?      @map("transaction_id") @db.Uuid
  note          String?
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, flowDate])
  @@map("portfolio_cashflows")
}

model PortfolioValuation {
  id            String          @id @default(uuid()) @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  portfolioId   String          @map("portfolio_id") @db.Uuid
  valuationDate DateTime        @map("valuation_date") @db.Date
  // 仅证券市值，不含现金，避免与账本现金重复
  marketValue   Decimal         @map("market_value") @db.Decimal(20, 6)
  source        ValuationSource @default(computed)
  note          String?
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, valuationDate])
  @@map("portfolio_valuations")
}

model PortfolioTarget {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @map("user_id") @db.Uuid
  portfolioId  String              @map("portfolio_id") @db.Uuid
  dimension    AllocationDimension
  key          String
  targetWeight Decimal             @map("target_weight") @db.Decimal(9, 6)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, dimension, key])
  @@map("portfolio_targets")
}

// ===== 风险模拟 =====

enum RunStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

// stage 描述「正在做什么」，status 描述「是否结束」，两者不互相推导
enum RunStage {
  preparing
  simulating
  aggregating
  finalizing
}

enum ReturnModel {
  lognormal
}

enum RebalanceFrequency {
  none
  monthly
  quarterly
  annual
}

model MonteCarloScenario {
  id           String             @id @default(uuid()) @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  name         String
  currency     String             @db.Char(3)
  years        Int
  pathCount    Int                @map("path_count")
  rebalance    RebalanceFrequency @default(annual)
  returnModel  ReturnModel        @default(lognormal) @map("return_model")
  // 资产数量与相关矩阵维度由用户决定，逐列建模会退化成动态列；
  // 写入前必须经校验归一化，不允许把请求体直接落库
  assets       Json
  correlation  Json
  settings     Json
  modelVersion String             @default("montecarlo-v1") @map("model_version")
  note         String?
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs MonteCarloRun[]

  @@unique([userId, name])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("monte_carlo_scenarios")
}

model MonteCarloRun {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  scenarioId        String    @map("scenario_id") @db.Uuid
  scenarioName      String    @map("scenario_name")
  status            RunStatus @default(queued)
  stage             RunStage?
  // 0.0000–1.0000，应用层保证单调不减
  progress          Decimal   @default(0) @db.Decimal(5, 4)
  attempts          Int       @default(0)
  // 完整不可变参数快照，保证方案被改后历史运行仍可解释与重算
  assumptions       Json
  seed              Int
  modelVersion      String    @map("model_version")
  pathCount         Int       @map("path_count")
  years             Int
  cancelRequestedAt DateTime? @map("cancel_requested_at") @db.Timestamptz(6)
  heartbeatAt       DateTime? @map("heartbeat_at") @db.Timestamptz(6)
  startedAt         DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt        DateTime? @map("finished_at") @db.Timestamptz(6)
  durationMs        Int?      @map("duration_ms")
  failureCode       String?   @map("failure_code")
  failureMessage    String?   @map("failure_message")
  // 聚合结果与少量年度采样路径；全量路径不落库，凭种子按索引再生成
  result            Json?
  samplePaths       Json?     @map("sample_paths")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario MonteCarloScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([scenarioId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("monte_carlo_runs")
}

enum GoalType {
  savings
  purchase
  education
  retirement
  emergency_fund
  financial_independence
  custom
}

enum GoalFundingSource {
  net_worth
  account
  portfolio
}

enum GoalStatus {
  active
  achieved
  archived
}

enum ReportType {
  net_worth
  cashflow
  analytics
  investment
  goals
  simulation
}

model FinancialGoal {
  id                   String            @id @default(uuid()) @db.Uuid
  userId               String            @map("user_id") @db.Uuid
  name                 String
  type                 GoalType          @default(savings)
  targetAmount         Decimal           @map("target_amount") @db.Decimal(20, 6)
  currency             String            @db.Char(3)
  targetDate           DateTime?         @map("target_date") @db.Date
  startedAt            DateTime          @map("started_at") @db.Date
  // 起算日已计入的金额；进度 = 增量 + 该值，避免历史资产负债拉成负数
  initialAmount        Decimal           @default(0) @map("initial_amount") @db.Decimal(20, 6)
  inflationAdjusted    Boolean           @default(false) @map("inflation_adjusted")
  inflationRate        Decimal?          @map("inflation_rate") @db.Decimal(10, 6)
  expectedAnnualReturn Decimal?          @map("expected_annual_return") @db.Decimal(10, 6)
  monthlyContribution  Decimal?          @map("monthly_contribution") @db.Decimal(20, 6)
  fundingSource        GoalFundingSource @default(net_worth) @map("funding_source")
  accountId            String?           @map("account_id") @db.Uuid
  portfolioId          String?           @map("portfolio_id") @db.Uuid
  priority             Int               @default(1)
  status               GoalStatus        @default(active)
  // 按月重算得到，非人工置位；余额回落后保留历史达成日
  achievedAt           DateTime?         @map("achieved_at") @db.Date
  note                 String?
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  portfolio Portfolio? @relation(fields: [portfolioId], references: [id], onDelete: SetNull)

  @@unique([userId, name])
  @@index([userId, status, priority])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("financial_goals")
}

model Report {
  id            String     @id @default(uuid()) @db.Uuid
  userId        String     @map("user_id") @db.Uuid
  type          ReportType
  title         String
  rangeFrom     DateTime   @map("range_from") @db.Date
  rangeTo       DateTime   @map("range_to") @db.Date
  currency      String     @db.Char(3)
  // 生成参数、口径与数据三者必须一起冻结：只存参数等于用今天的账本重算历史报表
  params        Json
  basis         Json
  data          Json
  rowCount      Int        @map("row_count")
  modelVersions Json       @map("model_versions")
  generatedAt   DateTime   @map("generated_at") @db.Timestamptz(6)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, type, createdAt(sort: Desc)])
  @@map("reports")
}

// ===== 数据管理、备份与运维 =====

enum ExportStatus {
  queued
  running
  ready
  failed
  expired
}

enum ExportScope {
  full
  ledger
  investments
  simulations
  planning
  settings
}

enum BackupStatus {
  creating
  ready
  failed
  expired
}

enum BackupFormat {
  json_encrypted
}

enum TaskKind {
  export
  backup
  restore
  recheck
}

enum TaskStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

model DataExport {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  scope       ExportScope
  format      String       @default("csv_zip")
  status      ExportStatus @default(queued)
  // 范围参数：起止日期、是否包含归档、实体域清单
  params      Json
  // 完成后写入：文件清单、行数、完整性声明
  manifest    Json?
  fileKey     String?      @map("file_key")
  sizeBytes   BigInt?      @map("size_bytes")
  sha256      String?      @db.Char(64)
  rowCount    Int?         @map("row_count")
  failureCode String?      @map("failure_code")
  expiresAt   DateTime?    @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt DateTime?    @map("completed_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([expiresAt])
  @@map("data_exports")
}

model Backup {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  format        BackupFormat @default(json_encrypted)
  schemaVersion String       @map("schema_version")
  // 覆盖的实体域与记录数快照
  scope         Json
  fileKey       String       @map("file_key")
  sizeBytes     BigInt       @map("size_bytes")
  // 明文逻辑包的摘要：恢复时先解密再校验，避免把乱码当成好包
  sha256        String       @db.Char(64)
  status        BackupStatus @default(creating)
  restoreCount  Int          @default(0) @map("restore_count")
  lastRestoredAt DateTime?   @map("last_restored_at") @db.Timestamptz(6)
  expiresAt     DateTime?    @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@index([expiresAt])
  @@map("backups")
}

model JobTask {
  id                String     @id @default(uuid()) @db.Uuid
  userId            String     @map("user_id") @db.Uuid
  kind              TaskKind
  status            TaskStatus @default(queued)
  // 0.0000–1.0000，应用层保证单调不减
  progress          Decimal    @default(0) @db.Decimal(5, 4)
  stage             String?
  targetType        String?    @map("target_type")
  targetId          String?    @map("target_id") @db.Uuid
  summary           Json?
  failureCode       String?    @map("failure_code")
  failureMessage    String?    @map("failure_message")
  attempts          Int        @default(0)
  heartbeatAt       DateTime?  @map("heartbeat_at") @db.Timestamptz(6)
  startedAt         DateTime?  @map("started_at") @db.Timestamptz(6)
  finishedAt        DateTime?  @map("finished_at") @db.Timestamptz(6)
  cancelRequestedAt DateTime?  @map("cancel_requested_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([kind, status])
  @@map("job_tasks")
}

model SystemSetting {
  key       String   @id @db.VarChar(64)
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("system_settings")
}
