# ===== 运行环境 =====
NODE_ENV=development

# ===== 数据库 =====
POSTGRES_DB=comporalife
POSTGRES_USER=comporalife
POSTGRES_PASSWORD=comporalife
DATABASE_URL=postgresql://comporalife:comporalife@localhost:5432/comporalife

# ===== Redis =====
REDIS_URL=redis://localhost:6379

# ===== 认证 =====
# 至少 32 个字符；生产环境请使用高熵随机值
JWT_SECRET=change-me-to-a-high-entropy-random-string
COOKIE_SECURE=false
SESSION_ACCESS_TTL=15m
SESSION_REFRESH_TTL=7d

# ===== 应用 =====
APP_BASE_URL=http://localhost:3000
DEFAULT_CURRENCY=CNY
LOG_LEVEL=info
# 仅本地开发设为 true；生产镜像不安装 pino-pretty
LOG_PRETTY=false

# ===== 邮件（可选，留空则密码重置不可用）=====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ===== 初始管理员（仅 seed 使用）=====
ADMIN_EMAIL=admin@comporalife.com
ADMIN_PASSWORD=admin123

# ===== 账单导入 =====
FILE_STORAGE_DIR=./data/imports
# base64 编码的 32 字节密钥，生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 缺失或长度不符会导致服务启动失败；请勿提交真实密钥
FILE_ENCRYPTION_KEY=
IMPORT_MAX_FILE_MB=10
IMPORT_MAX_ROWS=20000
IMPORT_FILE_RETENTION_DAYS=30
IMPORT_ROW_RETENTION_DAYS=365

# ===== 外部汇率源（留空则自动同步不可用；仅支持 https）=====
RATE_PROVIDER_URL=
RATE_PROVIDER_ANCHOR=USD
# 密钥只从环境变量读取，任何接口与日志都不会回显
RATE_PROVIDER_KEY=
RATE_PROVIDER_KEY_PARAM=apikey
RATE_PROVIDER_RATES_PATH=rates
# 留空则使用请求日期作为汇率日期
RATE_PROVIDER_DATE_PATH=
RATE_PROVIDER_TIMEOUT_MS=10000

# ===== 汇率同步调度 =====
RATE_SYNC_INTERVAL_MS=86400000
RATE_SYNC_STARTUP_DELAY_MS=60000
RATE_SYNC_LOCK_MS=300000
RATE_SYNC_RUN_RETENTION_DAYS=90
# 相对上次值的最大偏离百分比，超过即拒绝该币种对
RATE_MAX_DEVIATION_PCT=20
# 汇率滞后的天数阈值
RATE_STALE_DAYS=7
